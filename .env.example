# Password for localhost-only noVNC browser viewer. Change before starting Compose.
WEB_VNC_PASSWORD=change-this-password
MOYA_WEB_PORT=5173
MOYA_REVIEW_PORT=6080

# Optional existing Workday Careers account; used only by the local API.
# Scope to the employer tenant that owns the account. Never use VITE_ for secrets.
RESUME_SITE_HOST=workday.wd5.myworkdayjobs.com
RESUME_SITE_EMAIL=
RESUME_SITE_PASSWORD=
