# Runtime environment (does not change the development server command).
NODE_ENV=development

# Password for localhost-only noVNC browser viewer. Change before starting Compose.
WEB_VNC_PASSWORD=change-this-password
MOYA_WEB_PORT=5173
MOYA_REVIEW_PORT=6080

# Optional existing Workday account; scoped to the exact employer host.
# Never use VITE_ for secrets. WORKDAY_USER_EMAIL is also accepted as an alias.
WORKDAY_HOST=workday.wd5.myworkdayjobs.com
WORKDAY_USERNAME=
WORKDAY_USER_EMAIL=
WORKDAY_PASSWORD=

# Legacy variable names remain supported.
RESUME_SITE_EMAIL=
RESUME_SITE_PASSWORD=
