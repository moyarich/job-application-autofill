{
  "name": "job-application-autofill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types docker/dev.ts",
    "build": "npm run build:js && npm run build:python && npm run build --workspace apps/playground",
    "build:packages": "npm run build",
    "build:playground": "npm run build --workspace apps/playground",
    "test": "vitest run tests",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checks": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "pack:check": "npm pack --workspaces --dry-run",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev",
    "build:storybook": "storybook build",
    "dev:server": "npm run build --workspace packages/resume-api && npm run start --workspace packages/resume-api",
    "build:app": "npm run build:app --workspace packages/job-application-autofill",
    "build:js": "npm run build:js --workspace packages/resume && npm run build --workspace packages/job-boards && npm run build --workspace packages/job-application-autofill && npm run build --workspace packages/resume-api",
    "build:python": "node --experimental-strip-types scripts/build-resume-ocr.ts",
    "predev": "npm run build:python",
    "pretypecheck": "npm run build:js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.1",
    "eslint": "^10.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "jiti": "^2.6.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@playwright/test": "^1.56.0",
    "@storybook/react-vite": "^9.1.0",
    "storybook": "^9.1.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "@moyarich/resume": "0.1.0"
  }
}
