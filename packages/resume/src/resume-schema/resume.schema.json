{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moyarich/job-application-autofill/blob/main/packages/resume/src/resume-schema/resume.schema.json",
  "title": "MoyaApply Structured Resume",
  "description": "Canonical ATS-oriented r\u00e9sum\u00e9 content. Rendering rules are metadata, not automatic PDF/DOCX validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contact",
    "summary",
    "experience",
    "skills",
    "education",
    "projects",
    "certifications",
    "languages",
    "awards",
    "source"
  ],
  "properties": {
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstName",
        "lastName",
        "email",
        "phone",
        "location",
        "linkedIn",
        "github",
        "website"
      ],
      "properties": {
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "linkedIn": {
          "type": "string"
        },
        "github": {
          "type": "string"
        },
        "website": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "Markdown professional summary. Plain text is valid Markdown."
    },
    "experience": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experience"
      },
      "description": "Employment history. For export, present most recent role first under the Work Experience heading."
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "education": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/education"
      },
      "description": "Education section appears after Skills in the rendered document. Optional in extraction because the parser may not yet identify it."
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/certification"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "awards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileName"
      ],
      "properties": {
        "fileName": {
          "type": "string"
        }
      }
    },
    "additionalSections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "content"
        ],
        "properties": {
          "heading": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "description": "Markdown section content."
          }
        }
      }
    },
    "skillGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "content"
        ],
        "properties": {
          "heading": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company",
        "jobTitle",
        "location",
        "startDate",
        "endDate",
        "isCurrent",
        "description"
      ],
      "properties": {
        "company": {
          "type": "string",
          "default": ""
        },
        "jobTitle": {
          "type": "string",
          "default": ""
        },
        "location": {
          "type": "string",
          "default": ""
        },
        "startDate": {
          "type": "string",
          "pattern": "^(?:|[0-9]{4}(?:-(?:0[1-9]|1[0-2]))?)$",
          "description": "Machine-readable year or year-month; consistently render in human-readable month/year format."
        },
        "endDate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:|[0-9]{4}(?:-(?:0[1-9]|1[0-2]))?)$",
              "description": "YYYY, YYYY-MM, or empty if unknown"
            },
            {
              "type": "null"
            }
          ],
          "description": "Machine-readable year or year-month, or null for a current role. Do not invent end dates."
        },
        "isCurrent": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "default": "",
          "description": "Markdown content, converted to plain text for autofill and formatted content for document exports."
        }
      }
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "institution",
        "degree",
        "fieldOfStudy",
        "location",
        "startDate",
        "endDate",
        "description"
      ],
      "properties": {
        "institution": {
          "type": "string",
          "default": ""
        },
        "degree": {
          "type": "string",
          "default": ""
        },
        "fieldOfStudy": {
          "type": "string",
          "default": ""
        },
        "location": {
          "type": "string",
          "default": ""
        },
        "startDate": {
          "type": "string",
          "pattern": "^(?:|[0-9]{4}(?:-(?:0[1-9]|1[0-2]))?)$",
          "description": "YYYY, YYYY-MM, or empty if unknown"
        },
        "endDate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:|[0-9]{4}(?:-(?:0[1-9]|1[0-2]))?)$",
              "description": "YYYY, YYYY-MM, or empty if unknown"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string",
          "default": "",
          "description": "Markdown content, converted to plain text for autofill and formatted content for document exports."
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "url",
        "technologies"
      ],
      "properties": {
        "name": {
          "type": "string",
          "default": ""
        },
        "description": {
          "type": "string",
          "default": "",
          "description": "Markdown content, converted to plain text for autofill and formatted content for document exports."
        },
        "url": {
          "type": "string",
          "default": ""
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "issuer",
        "issuedDate",
        "expirationDate",
        "credentialId",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "default": ""
        },
        "issuer": {
          "type": "string",
          "default": ""
        },
        "issuedDate": {
          "type": "string",
          "pattern": "^(?:|[0-9]{4}(?:-(?:0[1-9]|1[0-2]))?)$",
          "description": "YYYY, YYYY-MM, or empty if unknown"
        },
        "expirationDate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:|[0-9]{4}(?:-(?:0[1-9]|1[0-2]))?)$",
              "description": "YYYY, YYYY-MM, or empty if unknown"
            },
            {
              "type": "null"
            }
          ]
        },
        "credentialId": {
          "type": "string",
          "default": ""
        },
        "url": {
          "type": "string",
          "default": ""
        }
      }
    }
  },
  "x-atsExportGuidance": {
    "reference": "https://resume.io/resume-templates/ats",
    "sectionOrder": [
      "contact",
      "summary",
      "experience",
      "skills",
      "education"
    ],
    "headings": {
      "summary": "Professional Summary",
      "experience": "Work Experience",
      "skills": "Skills",
      "education": "Education"
    },
    "layout": "single-column",
    "contactPlacement": "main-document-body",
    "bodyFontFamilies": [
      "Arial",
      "Calibri",
      "Times New Roman",
      "Georgia"
    ],
    "bodyFontSizePt": {
      "minimum": 10,
      "maximum": 12
    },
    "avoid": [
      "tables",
      "sidebars",
      "text boxes",
      "graphics",
      "images",
      "icons",
      "decorative lines",
      "skill bars"
    ],
    "bullets": [
      "round",
      "dash"
    ],
    "dates": "consistent year-and-month display, e.g. May 2023 to Present",
    "experienceOrder": "reverse-chronological",
    "defaultFileType": "docx",
    "pdf": "selectable text (not scanned image)",
    "fileTypeOverride": "follow job posting instructions",
    "keywords": "use accurate role-specific wording; do not fabricate skills or keyword-stuff"
  }
}
