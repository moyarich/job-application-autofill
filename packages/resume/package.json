{
  "name": "@moyarich/resume",
  "version": "0.1.0",
  "description": "Structured resume schema, validation, Markdown conversion, and document rendering",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./create-pdf": {
      "types": "./dist/create-resume/create-pdf.d.ts",
      "import": "./dist/create-pdf.js"
    },
    "./validate": {
      "types": "./dist/resume-schema/validate.d.ts",
      "import": "./dist/validate.js"
    },
    "./render-html": {
      "types": "./dist/create-resume/render-html.d.ts",
      "import": "./dist/render-html.js"
    },
    "./resume.schema.json": "./src/resume-schema/resume.schema.json",
    "./markdown": {
      "types": "./dist/markdown/markdown.d.ts",
      "import": "./dist/markdown.js"
    }
  },
  "files": [
    "dist",
    "src/resume-schema/resume.schema.json"
  ],
  "scripts": {
    "build": "npm run build:js",
    "build:js": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "markdown-it": "^15.0.3",
    "playwright": "^1.56.0",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0"
  },
  "bin": {
    "create-resume": "./dist/create-resume.js",
    "extract-resume": "./dist/extract-resume.js"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "@types/mdast": "^4.0.4"
  },
  "types": "./dist/index.d.ts"
}
