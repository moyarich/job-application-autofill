{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moyarich/job-application-autofill/blob/main/packages/extract-resume/schemas/resume.schema.json",
  "title": "MoyaApply Resume Profile",
  "description": "Structured resume JSON for parsing and ATS adapters. Empty strings mean unknown, not inferred; optional extended sections may be populated later.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "firstName",
    "lastName",
    "email",
    "phone",
    "location",
    "linkedIn",
    "github",
    "website",
    "summary",
    "skills",
    "resumeFileName",
    "experience"
  ],
  "properties": {
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "linkedIn": {
      "type": "string"
    },
    "github": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "description": "Professional Summary section, after contact information in the rendered document."
    },
    "skills": {
      "type": "string",
      "description": "Dedicated Skills section after Work Experience. Preserve relevant and accurate terms from the source; do not automatically insert job-description keywords."
    },
    "resumeFileName": {
      "type": "string"
    },
    "experience": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/experience"
      },
      "description": "Employment history. For export, present most recent role first under the Work Experience heading."
    },
    "education": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/education"
      },
      "description": "Education section appears after Skills in the rendered document. Optional in extraction because the parser may not yet identify it."
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/certification"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "awards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skillCategories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "items"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company",
        "jobTitle",
        "location",
        "startDate",
        "endDate",
        "isCurrent",
        "description"
      ],
      "properties": {
        "company": {
          "type": "string",
          "default": ""
        },
        "jobTitle": {
          "type": "string",
          "default": ""
        },
        "location": {
          "type": "string",
          "default": ""
        },
        "startDate": {
          "type": "string",
          "pattern": "^(?:|[0-9]{4}(?:-(?:0[1-9]|1[0-2]))?)$",
          "description": "Machine-readable year or year-month; consistently render in human-readable month/year format."
        },
        "endDate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:|[0-9]{4}(?:-(?:0[1-9]|1[0-2]))?)$",
              "description": "YYYY, YYYY-MM, or empty if unknown"
            },
            {
              "type": "null"
            }
          ],
          "description": "Machine-readable year or year-month, or null for a current role. Do not invent end dates."
        },
        "isCurrent": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "default": "",
          "description": "Plain-text responsibilities and accomplishments; render as ordinary round or dash bullets, never custom icons."
        }
      }
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "institution",
        "degree",
        "fieldOfStudy",
        "location",
        "startDate",
        "endDate",
        "description"
      ],
      "properties": {
        "institution": {
          "type": "string",
          "default": ""
        },
        "degree": {
          "type": "string",
          "default": ""
        },
        "fieldOfStudy": {
          "type": "string",
          "default": ""
        },
        "location": {
          "type": "string",
          "default": ""
        },
        "startDate": {
          "type": "string",
          "pattern": "^(?:|[0-9]{4}(?:-(?:0[1-9]|1[0-2]))?)$",
          "description": "YYYY, YYYY-MM, or empty if unknown"
        },
        "endDate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:|[0-9]{4}(?:-(?:0[1-9]|1[0-2]))?)$",
              "description": "YYYY, YYYY-MM, or empty if unknown"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string",
          "default": ""
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "url",
        "technologies"
      ],
      "properties": {
        "name": {
          "type": "string",
          "default": ""
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "url": {
          "type": "string",
          "default": ""
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "issuer",
        "issuedDate",
        "expirationDate",
        "credentialId",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "default": ""
        },
        "issuer": {
          "type": "string",
          "default": ""
        },
        "issuedDate": {
          "type": "string",
          "pattern": "^(?:|[0-9]{4}(?:-(?:0[1-9]|1[0-2]))?)$",
          "description": "YYYY, YYYY-MM, or empty if unknown"
        },
        "expirationDate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:|[0-9]{4}(?:-(?:0[1-9]|1[0-2]))?)$",
              "description": "YYYY, YYYY-MM, or empty if unknown"
            },
            {
              "type": "null"
            }
          ]
        },
        "credentialId": {
          "type": "string",
          "default": ""
        },
        "url": {
          "type": "string",
          "default": ""
        }
      }
    }
  },
  "$comment": "This schema validates structured resume data; document formatting (columns, font, tables, headers/footers, actual embedded text, and file format) must be validated separately at export time. Guidance: https://resume.io/resume-templates/ats",
  "x-atsExportGuidance": {
    "reference": "https://resume.io/resume-templates/ats",
    "sectionOrder": [
      "contact",
      "summary",
      "experience",
      "skills",
      "education"
    ],
    "headings": {
      "summary": "Professional Summary",
      "experience": "Work Experience",
      "skills": "Skills",
      "education": "Education"
    },
    "layout": "single-column",
    "contactPlacement": "main-document-body",
    "bodyFontFamilies": [
      "Arial",
      "Calibri",
      "Times New Roman",
      "Georgia"
    ],
    "bodyFontSizePt": {
      "minimum": 10,
      "maximum": 12
    },
    "avoid": [
      "tables",
      "sidebars",
      "text boxes",
      "graphics",
      "images",
      "icons",
      "decorative lines",
      "skill bars"
    ],
    "bullets": [
      "round",
      "dash"
    ],
    "dates": "consistent year-and-month display, e.g. May 2023 to Present",
    "experienceOrder": "reverse-chronological",
    "defaultFileType": "docx",
    "pdf": "selectable text (not scanned image)",
    "fileTypeOverride": "follow job posting instructions",
    "keywords": "use accurate role-specific wording; do not fabricate skills or keyword-stuff"
  }
}
