{
  "name": "@moyarich/extract-resume",
  "version": "0.1.0",
  "description": "Local PDF/DOCX resume extraction with PDFium and OCR fallback",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "python",
    "dist"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:python",
    "test:python": "poetry run python -m unittest discover -s python -p 'test_*.py' -v",
    "build:js": "vite build && tsc -p tsconfig.build.json",
    "build:python": "node scripts/build-python.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "bin": {
    "extract-resume": "./dist/cli.js"
  },
  "devDependencies": {
    "vite": "^7.3.7",
    "typescript": "^5.9.2",
    "@types/node": "^24.3.1"
  },
  "types": "./dist/index.d.ts"
}
